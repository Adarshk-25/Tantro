# Public canonical URL used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://tantro.in

# Contact form delivery (server-side only). Delivery uses the Resend HTTP API.
# Without RESEND_API_KEY the form validates input but reports that delivery is
# not configured — it never pretends a message was sent.
RESEND_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=info@tantro.in
# Verified sender on your Resend domain, e.g. "Tantro Website <web@tantro.in>".
CONTACT_FROM_EMAIL=
